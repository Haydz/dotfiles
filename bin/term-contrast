#!/usr/bin/env python3
"""term-contrast — audit the Alacritty themes against their contrast policy.

    term-contrast           audit both themes, full table
    term-contrast --quiet   print only failures (for CI / pre-commit)

Exists because "colours are chosen against measured contrast" was true of
this repo right up until it wasn't: the light theme shipped a comment
claiming its grey was 7.0:1 while measuring 5.51:1 against the background
actually in use, and four other slots sat below AA. The claim was checked
against #ffffff and then the background changed. Contrast is a property of
a PAIR, so any value copied from an upstream theme is unverified here.

The policy encoded below is deliberately not "everything at AAA". Terminals
need a readable dim tier — comments that cannot be de-emphasised are their
own legibility problem — so the dim slots have their own, lower floors and
are exempt from the 7:1 bar by design, not by accident.
"""
import sys, pathlib, itertools, math

if sys.version_info < (3, 11):
    sys.exit("term-contrast needs python 3.11+ for tomllib")
import tomllib

# slot -> minimum contrast against that theme's own background
BODY = 7.0          # anything you read for minutes at a time
FLOORS = {
    "normal.black": 3.0,    # dim tier; also used as a background by some TUIs
    "bright.black": 6.0,    # the comment / secondary-text slot
    "dim.black": 2.5,       # dimmest slot in the theme
}
DIM_HUE_FLOOR = 4.5         # dim.<hue> — AA, still comfortably readable

HUES = ("red", "green", "yellow", "blue", "magenta", "cyan")


def _lin(c):
    c /= 255
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _lum(hx):
    h = hx.lstrip("#")
    r, g, b = (_lin(int(h[i:i + 2], 16)) for i in (0, 2, 4))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = _lum(a), _lum(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def _lab(hx):
    h = hx.lstrip("#")
    r, g, b = (_lin(int(h[i:i + 2], 16)) for i in (0, 2, 4))
    X = r * .4124 + g * .3576 + b * .1805
    Y = r * .2126 + g * .7152 + b * .0722
    Z = r * .0193 + g * .1192 + b * .9505
    f = lambda t: t ** (1 / 3) if t > 0.008856 else 7.787 * t + 16 / 116
    fx, fy, fz = f(X / .95047), f(Y), f(Z / 1.08883)
    return 116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz)


def de2000(h1, h2):
    """CIEDE2000. Under ~10, two colours start being mistaken for each other."""
    L1, a1, b1 = _lab(h1)
    L2, a2, b2 = _lab(h2)
    C1, C2 = math.hypot(a1, b1), math.hypot(a2, b2)
    Cb = (C1 + C2) / 2
    G = .5 * (1 - math.sqrt(Cb ** 7 / (Cb ** 7 + 25 ** 7))) if Cb else 0
    a1p, a2p = (1 + G) * a1, (1 + G) * a2
    C1p, C2p = math.hypot(a1p, b1), math.hypot(a2p, b2)
    h1p = math.degrees(math.atan2(b1, a1p)) % 360
    h2p = math.degrees(math.atan2(b2, a2p)) % 360
    dLp, dCp = L2 - L1, C2p - C1p
    if C1p * C2p == 0:
        dhp = 0
    elif abs(h2p - h1p) <= 180:
        dhp = h2p - h1p
    else:
        dhp = h2p - h1p - 360 if h2p > h1p else h2p - h1p + 360
    dHp = 2 * math.sqrt(C1p * C2p) * math.sin(math.radians(dhp) / 2)
    Lbp, Cbp = (L1 + L2) / 2, (C1p + C2p) / 2
    if C1p * C2p == 0:
        hbp = h1p + h2p
    elif abs(h1p - h2p) <= 180:
        hbp = (h1p + h2p) / 2
    elif h1p + h2p < 360:
        hbp = (h1p + h2p + 360) / 2
    else:
        hbp = (h1p + h2p - 360) / 2
    T = (1 - .17 * math.cos(math.radians(hbp - 30))
         + .24 * math.cos(math.radians(2 * hbp))
         + .32 * math.cos(math.radians(3 * hbp + 6))
         - .20 * math.cos(math.radians(4 * hbp - 63)))
    Sl = 1 + (.015 * (Lbp - 50) ** 2) / math.sqrt(20 + (Lbp - 50) ** 2)
    Sc, Sh = 1 + .045 * Cbp, 1 + .015 * Cbp * T
    Rc = 2 * math.sqrt(Cbp ** 7 / (Cbp ** 7 + 25 ** 7)) if Cbp else 0
    Rt = -math.sin(math.radians(2 * 30 * math.exp(-((hbp - 275) / 25) ** 2))) * Rc
    return math.sqrt((dLp / Sl) ** 2 + (dCp / Sc) ** 2 + (dHp / Sh) ** 2
                     + Rt * (dCp / Sc) * (dHp / Sh))


def floor_for(slot):
    if slot in FLOORS:
        return FLOORS[slot]
    if slot.startswith("dim."):
        return DIM_HUE_FLOOR
    return BODY


def audit(path, quiet):
    data = tomllib.loads(path.read_text())
    colors = data.get("colors", {})
    bg = colors.get("primary", {}).get("background")
    if not bg:
        print(f"{path.name}: no colors.primary.background — cannot audit")
        return 1

    slots = {}
    for group in ("normal", "bright", "dim"):
        for name, val in colors.get(group, {}).items():
            slots[f"{group}.{name}"] = val
    for name, val in colors.get("primary", {}).items():
        if name != "background":
            slots[f"primary.{name}"] = val

    fails = []
    rows = []
    for slot, val in slots.items():
        c = contrast(val, bg)
        need = floor_for(slot)
        ok = c >= need - 0.005
        rows.append((slot, val, c, need, ok))
        if not ok:
            fails.append((slot, val, c, need))

    if not quiet:
        print(f"\n{path.name}   background {bg}")
        print(f"  {'slot':22} {'colour':9} {'measured':>9}  {'floor':>6}")
        for slot, val, c, need, ok in rows:
            print(f"  {slot:22} {val:9} {c:8.2f}:1  {need:5.1f}:1"
                  f"{'' if ok else '   FAIL'}")

        n, b = colors.get("normal", {}), colors.get("bright", {})
        steps = [(de2000(n[h], b[h]), h) for h in HUES if h in n and h in b]
        if steps:
            worst, wh = min(steps)
            print(f"  normal->bright emphasis step: worst dE {worst:.1f} ({wh})"
                  + ("   <-- identical, no emphasis possible" if worst < 1 else ""))
        present = [(h, n[h]) for h in HUES if h in n]
        if len(present) > 1:
            d, x, y = min((de2000(p[1], q[1]), p[0], q[0])
                          for p, q in itertools.combinations(present, 2))
            print(f"  tightest hue pair:            dE {d:.1f} ({x}/{y})"
                  + ("   <-- confusable" if d < 10 else ""))

    for slot, val, c, need in fails:
        print(f"{path.name}: {slot} {val} is {c:.2f}:1, needs {need:.1f}:1")
    return len(fails)


def main():
    quiet = "--quiet" in sys.argv or "-q" in sys.argv
    here = pathlib.Path(__file__).resolve().parent.parent / "alacritty"
    themes = sorted(here.glob("theme-*.toml"))
    if not themes:
        sys.exit(f"no theme-*.toml found in {here}")
    bad = sum(audit(t, quiet) for t in themes)
    if not quiet:
        print()
    if bad:
        sys.exit(f"{bad} slot(s) below their contrast floor")
    if not quiet:
        print("all slots meet their contrast floor")


if __name__ == "__main__":
    main()
